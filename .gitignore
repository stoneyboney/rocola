# macOS
.DS_Store

# Secrets. LASTFM_API_KEY lives here; .env.example is the committed template.
# last.fm read endpoints need only a key, but a key is still a credential.
.env
.env.*
!.env.example

# Lyric text, in any staging form. SPEC §12: Rocola never bundles, ships or
# redistributes lyrics, so there is no path by which a file here belongs in
# the repository. The rule exists before the directory does, deliberately.
lyrics/

# Anki exports and the known-lemma seed built from them. Personal vocabulary,
# and regenerable from the deck at any time.
*.anki.txt
known.json

# Downloaded Wiktionary extracts and the shared gloss cache. Derived data: a
# rebuild reproduces all of it, and the extracts alone are over a gigabyte.
cache/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
dist/
dev-dist/
