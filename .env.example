# last.fm read-only API key.
#
# Read endpoints need only a key — there is no OAuth flow to complete, and
# Rocola never writes to last.fm. Create one at:
#   https://www.last.fm/api/account/create
#
# Copy this file to .env and fill it in. .env is gitignored; this file is the
# template and must never hold a real value.
LASTFM_API_KEY=

# The last.fm account whose scrobbles choose the songs.
LASTFM_USER=
